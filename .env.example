# Repohaus environment template — placeholders only.
# Copy to .env for local development. Never commit real values.

# Django core
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — local default is SQLite; use DATABASE_URL or MySQL vars for deployed environments.
DB_ENGINE=django.db.backends.sqlite3
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_NAME=devmarket_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render provides this automatically on Render.
# RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

# Email SMTP — use an app password in real environments.
EMAIL_HOST_USER=replace-with-your-smtp-email
EMAIL_HOST_PASSWORD=replace-with-your-smtp-app-password

# Razorpay — test mode by default. Live keys start with rzp_live_.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET
RAZORPAY_TEST_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID
RAZORPAY_TEST_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET
RAZORPAY_TEST_WEBHOOK_SECRET=REPLACE_WITH_YOUR_TEST_WEBHOOK_SECRET
# RAZORPAY_LIVE_KEY_ID=rzp_live_REPLACE_WITH_YOUR_LIVE_KEY_ID
# RAZORPAY_LIVE_KEY_SECRET=REPLACE_WITH_YOUR_LIVE_KEY_SECRET
# RAZORPAY_LIVE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_LIVE_WEBHOOK_SECRET

# WhatsApp Cloud API — optional notifications.
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ADMIN_NUMBER=REPLACE_WITH_YOUR_ADMIN_WHATSAPP_NUMBER

# Deployment seeding — set true only for first-time bootstrap.
SEED_INITIAL_DATA=false

# Frontend Vite variables — for frontend/.env in local frontend development.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_SITE_URL=http://127.0.0.1:5173
VITE_GA_MEASUREMENT_ID=G-REPLACE_WITH_YOUR_MEASUREMENT_ID
