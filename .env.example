DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.mysql
DB_NAME=devmarket_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Razorpay Payment Gateway Configuration
# Mode: "test" (default) or "live"
RAZORPAY_MODE=test

# Test Mode Credentials (keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret

# Optional Explicit Test Credentials
RAZORPAY_TEST_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_TEST_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_TEST_WEBHOOK_SECRET=replace_with_test_webhook_secret

# Production / Live Credentials (keys start with rzp_live_)
# Leave blank during testing. Fill only when switching to Live Mode.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
